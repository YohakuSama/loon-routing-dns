#!name = LoonKit · 网络辅助
#!desc = 查看节点信息、检查网络连接与常用服务状态
#!author = YohakuSama
#!homepage = https://github.com/YohakuSama/loonkit
#!icon = https://raw.githubusercontent.com/YohakuSama/loonkit/97c48a5d14087597dbba35119d5ee8d43b1ce537/icons/v20261021r1/Console.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 网络,节点,诊断
#!date = 2026-10-21
#!type = normal

[Argument]
auto_check = switch,false,tag=网络切换提醒,desc=默认关闭；网络切换后连续检测失败才提醒
target_policy = input,"Proxy",tag=查询策略,desc=查询节点信息所用的策略，默认 Proxy
compare_direct = switch,false,tag=直连 IP 对照,desc=开启后额外显示当前网络的公网 IP
service = select,"请选择服务","Spotify（音乐）","Twitch（直播）","Abema（视频）","BBC（资讯）","LINE（通讯）","Reddit（社区）","LinkedIn（职场）",tag=检测服务,desc=先选择一项，再手动运行「服务检测」

[Script]
generic then script("https://raw.githubusercontent.com/YohakuSama/loonkit/97c48a5d14087597dbba35119d5ee8d43b1ce537/scripts/v20261021r1/node-intelligence.js", {${target_policy}, ${compare_direct}}) with tag="节点信息", img_url="location.fill.viewfinder.system", timeout=40
generic then script("https://raw.githubusercontent.com/YohakuSama/loonkit/af78ebb6b75bdbb341996db446d87cb2be719af4/scripts/v20261021r2/network-diagnostics.js", {${auto_check}}) with tag="网络检测", img_url="network.system", timeout=40
generic then script("https://raw.githubusercontent.com/YohakuSama/loonkit/83e4afc4773a40df460f95b6a152a6766fdec00e/scripts/v20261021r7/service-diagnostics.js", {${service}}) with tag="服务检测", img_url="network", timeout=22
network-changed then script("https://raw.githubusercontent.com/YohakuSama/loonkit/af78ebb6b75bdbb341996db446d87cb2be719af4/scripts/v20261021r2/network-diagnostics.js", {${auto_check}}) with enable=${auto_check}, tag="网络切换异常监测", timeout=40
