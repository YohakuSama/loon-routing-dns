#!name = LoonKit · 诊断修复测试
#!desc = 仅供对照测试：单节点网络检测与旧版解锁判断
#!author = YohakuSama
#!homepage = https://github.com/YohakuSama/loonkit
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!type = normal

[Argument]
target_policy = input,"Proxy",tag=检测节点,desc=推荐从单个节点菜单运行

[Script]
generic then script("https://raw.githubusercontent.com/YohakuSama/loonkit/13359f833edfc1b2fd83aa078e8e05ef3a17137f/scripts/v20261022r9/network-diagnostics.js", {${target_policy}}) with tag="网络检测-候选", img_url="network.system", timeout=40
generic then script("https://raw.githubusercontent.com/YohakuSama/loonkit/13359f833edfc1b2fd83aa078e8e05ef3a17137f/scripts/v20261022r9/media-unlock-legacy.js", {${target_policy}}) with tag="解锁检测-旧版对照", img_url="play.rectangle.system", timeout=30
