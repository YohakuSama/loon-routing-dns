[Rule]
# Ensure the public IP diagnostic site follows the selected Proxy policy.
# ChinaMaxNoMedia_Domain incorrectly classifies browserleaks.com as China DIRECT.
# Domain rule is local, so it takes precedence over the remote domain-set.
# This is a routing exception, NOT proof of zero DNS leakage.
DOMAIN-SUFFIX,browserleaks.com,Proxy
# Other confirmed upstream ChinaMaxNoMedia mistakes. Preserve their proxy exit.
DOMAIN-SUFFIX,whatismyip.com,Proxy
# Stripe is an international payment service; a ChinaDirect keyword rule is overbroad.
DOMAIN-SUFFIX,stripe.com,Proxy

# Restore the pre-migration local routing priorities.
# No private proxy subscription is included in this public profile.
# Remote Resources
DOMAIN-SUFFIX,raw.githubusercontent.com,Proxy

