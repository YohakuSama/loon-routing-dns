[Rule]
# Emergency resource routing and final fallbacks only.
# All service domains are source-controlled under rules/custom and rules/generated.
# GitHub Raw often needs an already-working proxy in mainland China.
# Restore a node locally before fetching remote rules; this cannot bootstrap
# an otherwise blocked GitHub Raw URL without a functioning proxy.
DOMAIN-SUFFIX,raw.githubusercontent.com,Proxy
# Retain no-resolve: avoid triggering local DNS merely to classify unmatched proxy domains.
GEOIP,CN,DIRECT,no-resolve
FINAL,Final

# Node information and basic network diagnostics.
[Plugin]
https://raw.githubusercontent.com/YohakuSama/loonkit/main/plugins/v20261018r11/Network_Diagnostics.plugin, enabled=true
