#!name = LoonKit · 网络辅助
#!desc = 查看节点出口、网络状态和 DNS 连接情况
#!author = YohakuSama
#!homepage = https://github.com/YohakuSama/loonkit
#!icon = https://raw.githubusercontent.com/YohakuSama/loonkit/main/icons/v20261018r2/Console.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 网络,节点,诊断
#!type = normal

[Argument]
auto_check = switch,false,tag=网络切换提醒,desc=开启后在网络切换时检测连接，异常时提醒
target_policy = input,"Proxy",tag=查询策略,desc=默认 Proxy；从节点菜单运行时使用所选节点
compare_direct = switch,false,tag=直连 IP 对照,desc=可选；会向查询服务提供直连公网 IP

[Script]
generic then script("https://raw.githubusercontent.com/YohakuSama/loonkit/main/scripts/v20261018r11/node-intelligence.js", {${target_policy}, ${compare_direct}}) with tag="节点出口信息", img_url="location.fill.viewfinder.system", timeout=40
generic then script("https://raw.githubusercontent.com/YohakuSama/loonkit/main/scripts/v20261018r11/network-diagnostics.js", {${auto_check}}) with tag="网络与 DNS 诊断", img_url="network.system", timeout=40
network-changed then script("https://raw.githubusercontent.com/YohakuSama/loonkit/main/scripts/v20261018r11/network-diagnostics.js", {${auto_check}}) with enable=${auto_check}, tag="网络切换异常监测", timeout=40
