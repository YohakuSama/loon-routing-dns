#!name = Loon Routing DNS · 网络辅助 v2.3
#!desc = 节点出口、网络与 DNS 诊断、手动 DNS 解析器泄漏检测；网络变化异常提醒默认关闭，不修改 Loon 配置
#!author = YohakuSama
#!homepage = https://github.com/YohakuSama/loon-routing-dns
#!icon = https://raw.githubusercontent.com/YohakuSama/loon-routing-dns/main/icons/v20261018r2/Console.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 网络,节点,诊断
#!type = normal

[Argument]
auto_check = switch,false,tag=网络变化异常提醒,desc=默认关闭；开启后仅在网络切换时进行两次确认，异常才提醒
target_policy = input,"Proxy",tag=节点查询目标,desc=默认查询 Proxy；从节点菜单调用时优先使用当前节点
compare_direct = switch,false,tag=对照直连出口 IP,desc=默认关闭；开启后真实公网 IP 会提供给第三方情报服务

[Script]
generic then script("https://raw.githubusercontent.com/YohakuSama/loon-routing-dns/main/scripts/v20261018r5/node-intelligence.js", {${target_policy}, ${compare_direct}}) with tag="节点出口信息", img_url="location.fill.viewfinder.system", timeout=40
generic then script("https://raw.githubusercontent.com/YohakuSama/loon-routing-dns/main/scripts/v20261018r4/network-diagnostics.js", {${auto_check}}) with tag="网络与 DNS 诊断", img_url="network.system", timeout=40
generic then script("https://raw.githubusercontent.com/YohakuSama/loon-routing-dns/main/scripts/v20261018r7/dns-leak-check.js") with tag="DNS 解析器检测（改进版）", img_url="lock.shield.system", timeout=40
network-changed then script("https://raw.githubusercontent.com/YohakuSama/loon-routing-dns/main/scripts/v20261018r4/network-diagnostics.js", {${auto_check}}) with enable=${auto_check}, tag="网络切换异常监测", timeout=40
